                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "runtime/executor-worker.php"
                        ],
                        "reason": "PHP filesystem APIs can dereference network URL wrappers; the HMAC-authorized worker's guard rejects :// wrappers, NUL bytes, and off-root/symlink paths before opening. Bounded filesystem security regressions enforce this contract.",
                        "security": {
                            "sanitizer": "runtime/executor-worker.php",
                            "sha256": "a20a4d04a8473ff13e482228c3d87e2023af7fe5ef25e69554cf03e0a1b905b7",
                            "tests": [
                                "tests/AsyncFilePathPolicyTest.php",
                                "tests/AsyncFileSpecialFileSafetyTest.php"
                            ]
                        },
                        "taint": "ssrf"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "runtime/executor-worker.php"
                        ],
                        "reason": "PHP file_get_contents() and fopen() interpret wrapper-capable path strings as URL components. Authenticated executor guardFilePath validates local path shape, rejects stream-wrapper syntax, and enforces restricted-root and file-kind checks; security tests cover the boundary.",
                        "security": {
                            "sanitizer": "runtime/executor-worker.php",
                            "sha256": "a20a4d04a8473ff13e482228c3d87e2023af7fe5ef25e69554cf03e0a1b905b7",
                            "tests": [
                                "tests/AsyncFilePathPolicyTest.php",
                                "tests/AsyncFileSpecialFileSafetyTest.php"
                            ]
                        },
                        "taint": "url_component"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "runtime/executor-worker.php"
                        ],
                        "reason": "The worker's HMAC-authenticated and stream-wrapper-rejecting path guard feeds PHP fopen/file_get_contents, which Psalm models as URL-path sinks (TaintedUrlPath). Strict wrapper, null-byte, restricted-root/symlink and file-kind security regressions enforce the sanitized boundary.",
                        "security": {
                            "sanitizer": "runtime/executor-worker.php",
                            "sha256": "a20a4d04a8473ff13e482228c3d87e2023af7fe5ef25e69554cf03e0a1b905b7",
                            "tests": [
                                "tests/AsyncFilePathPolicyTest.php",
                                "tests/AsyncFileSpecialFileSafetyTest.php"
                            ]
                        },
                        "taint": "url_path"
                    },
                    {
                        "directive": "@psalm-suppress",
                        "issue": "UnresolvableInclude",
                        "paths": [
                            "benchmarks/cli_local_paths.php"
                        ],
                        "reason": "Intentional developer-selected Composer checkout; validated canonical autoload entrypoint cannot be statically resolved by Psalm and must remain dynamically loaded."
                    },
                    {
                        "directive": "@psalm-suppress",
                        "issue": "WeakHash",
                        "paths": [
                            "benchmarks/websocket_evidence.php",
                            "src/WebSocket/Internal/WebSocketClientHandshake.php",
                            "src/WebSocket/WebSocketUpgrade.php",
                            "tests/WebSocketClientHandshakeTest.php",
                            "tests/WebSocketOutboundClientTest.php",
                            "tests/WebSocketOutboundTlsTest.php"
                        ],
                        "reason": "RFC 6455 requires SHA-1 solely for Sec-WebSocket-Accept interoperability, not password storage, signatures or collision-resistant security; production and independent-peer handshake tests assert the mandated wire behavior."
                    }
                ]
            }
